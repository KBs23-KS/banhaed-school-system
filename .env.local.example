# Firebase Admin (SERVER ONLY — do not commit real secrets)
FIREBASE_PROJECT_ID=banhaed-school-system-43dc6
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Student sessions — generate a random secret >=32 chars, unique per environment
STUDENT_SESSION_SECRET=

# Optional: first Admin only (remove after setup)
BOOTSTRAP_SECRET=

# Optional: opt-in FIRST-ADMIN auto-bootstrap only; normal Admin Login uses Firebase Auth directly
ENABLE_AUTO_ADMIN_BOOTSTRAP=false
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=ผู้ดูแลระบบ

# Private Google Drive folder; grant service account least-privilege access
GOOGLE_DRIVE_FOLDER_ID=

# Preview ONLY: set ALL five fields to a separate test Firebase Web App configuration
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
